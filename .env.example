# Local dev; DATABASE_URL matches docker-compose.yml defaults
DATABASE_URL=postgresql://notes:notes@localhost:5432/notes_cards
PORT=3000
# at least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# base64 of exactly 32 random bytes; generate with: openssl rand -base64 32
AI_KEY_SECRET=
# GitHub OAuth App (callback URL must match GITHUB_CALLBACK_URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
WEB_URL=http://localhost:5173
# false only for local http; keep true in production
COOKIE_SECURE=false
